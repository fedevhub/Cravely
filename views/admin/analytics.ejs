<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Analytics | Cravely</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Text&family=Poppins:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="/css/sidebar.css" />
    <link rel="stylesheet" href="/css/admin-pages.css" />
  </head>
  <body>
    <div class="dashboard-container">
      <%- include('../partials/sidebar') %>
      <main class="admin-page">
        <header class="admin-page-header">
          <div>
            <p class="eyebrow">BUSINESS OVERVIEW</p>
            <h1>Financial Analytics</h1>
            <p>Pantau revenue, modal, pengeluaran, dan profit Cravely.</p>
          </div>
        </header>
        <section class="admin-stats">
          <div>
            <span>Total revenue</span
            ><strong>Rp <%= metrics.revenue.toLocaleString('id-ID') %></strong>
          </div>
          <div>
            <span>Total expenses</span
            ><strong>Rp <%= metrics.expensesTotal.toLocaleString('id-ID') %></strong>
          </div>
          <div>
            <span>Material value</span
            ><strong>Rp <%= metrics.materialValue.toLocaleString('id-ID') %></strong>
          </div>
          <div>
            <span>Net result</span
            ><strong class="<%= metrics.profit >= 0 ? 'positive' : 'negative' %>"
              >Rp <%= metrics.profit.toLocaleString('id-ID') %></strong
            >
          </div>
        </section>
        <section class="admin-grid analytics-grid">
          <article class="admin-panel breakdown">
            <div class="panel-title"><h2>Expense breakdown</h2></div>
            <div class="breakdown-row">
              <span>Initial capital</span
              ><b>Rp <%= metrics.capitalExpenses.toLocaleString('id-ID') %></b>
            </div>
            <div class="breakdown-row">
              <span>Materials</span
              ><b>Rp <%= metrics.materialExpenses.toLocaleString('id-ID') %></b>
            </div>
            <div class="breakdown-row">
              <span>Operational</span
              ><b>Rp <%= metrics.operationalExpenses.toLocaleString('id-ID') %></b>
            </div>
          </article>
          <article class="admin-panel">
            <div class="panel-title">
              <h2>Expense history</h2>
              <span><%= expenses.length %> latest</span>
            </div>
            <div class="expense-list">
              <% if (expenses.length) { expenses.forEach((item) => { %>
              <div class="expense-row">
                <span class="expense-icon"><i class="fa-solid fa-receipt"></i></span>
                <div>
                  <strong><%= item.description %></strong
                  ><small
                    ><%= item.type %> · <%= new Date(item.date).toLocaleDateString('id-ID')
                    %></small
                  >
                </div>
                <b>Rp <%= item.amount.toLocaleString('id-ID') %></b>
              </div>
              <% }) } else { %>
              <p class="empty-cell">Belum ada data pengeluaran.</p>
              <% } %>
            </div>
          </article>
        </section>
      </main>
    </div>
  </body>
</html>
