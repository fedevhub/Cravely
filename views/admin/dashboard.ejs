<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=Poppins:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="/css/sidebar.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/modal.css" />
  </head>

  <body>
    <div class="dashboard-container">
      <%- include('../partials/sidebar') %>

      <div class="main">
        <main class="main-content">
          <section class="dashboard-header">
            <div>
              <h1>Dashboard Overview</h1>
              <p><%= batchLabel %></p>
            </div>

            <div class="batch-actions">
              <span class="status-dot <%= isPreOrderOpen ? 'is-open' : 'is-closed' %>"></span>
              <span>Pre-order <%= isPreOrderOpen ? 'Open' : 'Closed' %></span>
              <form action="/dashboard/pre-order/toggle" method="POST">
                <button type="submit">
                  <%= isPreOrderOpen ? 'Close Pre-order' : 'Open Pre-order' %>
                </button>
              </form>
            </div>
          </section>

          <section class="stats-grid">
            <article class="stat-card">
              <div class="stat-top">
                <span class="stat-icon revenue"><i class="fa-solid fa-dollar-sign"></i></span>
                <span class="trend up"><i class="fa-solid fa-arrow-trend-up"></i> +18%</span>
              </div>
              <strong><%= formatShortCurrency(stats.totalRevenue) %></strong>
              <p>Total Revenue</p>
            </article>

            <article class="stat-card">
              <div class="stat-top">
                <span class="stat-icon orders"><i class="fa-regular fa-clipboard"></i></span>
                <span class="trend up"><i class="fa-solid fa-arrow-trend-up"></i> +12%</span>
              </div>
              <strong><%= stats.totalOrders.toLocaleString("id-ID") %></strong>
              <p>Total Orders</p>
            </article>

            <article class="stat-card">
              <div class="stat-top">
                <span class="stat-icon customers"><i class="fa-solid fa-users"></i></span>
                <span class="trend up"><i class="fa-solid fa-arrow-trend-up"></i> +24%</span>
              </div>
              <strong><%= stats.activeCustomers.toLocaleString("id-ID") %></strong>
              <p>Active Customers</p>
            </article>

            <article class="stat-card">
              <div class="stat-top">
                <span class="stat-icon payments"><i class="fa-regular fa-clock"></i></span>
                <span class="trend down"><i class="fa-solid fa-arrow-trend-down"></i> -5%</span>
              </div>
              <strong><%= stats.pendingPayments.toLocaleString("id-ID") %></strong>
              <p>Pending Payments</p>
            </article>
          </section>

          <section class="dashboard-grid charts-grid">
            <article class="panel revenue-panel">
              <div class="panel-header">
                <h2>Revenue - Sweet vs Savory</h2>
                <div class="legend">
                  <span><i class="sweet"></i> Sweet</span>
                  <span><i class="savory"></i> Savory</span>
                </div>
              </div>

              <div class="chart-canvas-wrap revenue-chart-wrap">
                <canvas id="revenueChart" aria-label="Revenue Sweet dan Savory"></canvas>
              </div>
            </article>

            <article class="panel status-panel">
              <h2>Order Status Distribution</h2>

              <div class="donut-wrap">
                <canvas id="statusChart" aria-label="Distribusi status order"></canvas>
              </div>

              <div class="status-list">
                <% statusCounts.forEach(item => { %>
                <div class="status-row">
                  <span
                    ><i
                      class="status-color status-color-<%= item.status.toLowerCase().replaceAll(' ', '-') %>"
                    ></i
                    ><%= item.status %></span
                  >
                  <strong><%= item.count %></strong>
                </div>
                <% }) %>
              </div>

              <div id="statusData" hidden>
                <% statusCounts.forEach(item => { %>
                <span class="status-data"
                  ><%= item.status %>|<%= item.color %>|<%= item.count %></span
                >
                <% }) %>
              </div>
            </article>
          </section>

          <section class="dashboard-grid bottom-grid">
            <article class="panel recent-panel">
              <div class="panel-header">
                <h2>Recent Orders</h2>
                <a href="/dashboard/orders">See all <i class="fa-solid fa-arrow-right"></i></a>
              </div>

              <div class="recent-list">
                <% if (recentOrders.length > 0) { %> <% recentOrders.forEach(order => { %>
                <div class="order-row">
                  <div class="order-customer">
                    <span class="avatar"><%= order.initials %></span>
                    <div>
                      <strong><%= order.customerName %></strong>
                      <p><%= order.orderNumber %> &middot; <%= order.itemCount %> items</p>
                    </div>
                  </div>

                  <div class="order-meta">
                    <strong>Rp <%= order.totalAmount.toLocaleString("id-ID") %></strong>
                    <span
                      class="order-status <%= order.status.toLowerCase().replaceAll(' ', '-') %>"
                      ><%= order.status %></span
                    >
                  </div>
                </div>
                <% }) %> <% } else { %>
                <div class="empty-state">Belum ada order terbaru.</div>
                <% } %>
              </div>
            </article>

            <article class="panel stock-panel">
              <div class="panel-header">
                <h2><i class="fa-solid fa-triangle-exclamation"></i> Low Stock Alerts</h2>
                <a href="/dashboard/products">Manage <i class="fa-solid fa-arrow-right"></i></a>
              </div>

              <div class="stock-list">
                <% if (lowStockAlerts.length > 0) { %> <% lowStockAlerts.forEach(item => { %>
                <div class="stock-row">
                  <span class="stock-dot <%= item.level %>"></span>
                  <div class="stock-info">
                    <div class="stock-title">
                      <strong><%= item.name %></strong>
                      <b><%= item.current %>/<%= item.max %></b>
                    </div>
                    <div class="stock-track">
                      <progress
                        class="stock-progress <%= item.level %>"
                        value="<%= item.current %>"
                        max="<%= item.max %>"
                      ></progress>
                    </div>
                  </div>
                </div>
                <% }) %> <% } else { %>
                <div class="empty-state">Belum ada produk untuk ditampilkan.</div>
                <% } %>
              </div>

              <div class="mini-cards">
                <div class="mini-card">
                  <i class="fa-solid fa-trophy"></i>
                  <span>Best Seller</span>
                  <strong><%= lowStockAlerts[0] ? lowStockAlerts[0].name : "No menu yet" %></strong>
                </div>

                <div class="mini-card">
                  <i class="fa-solid fa-cube"></i>
                  <span>This Batch</span>
                  <strong><%= batchLabel.split(" - ")[0] %></strong>
                </div>
              </div>
            </article>
          </section>

          <div id="revenueData" hidden>
            <% revenueMonths.forEach(month => { %>
            <span class="revenue-data"
              ><%= month.label %>|<%= month.sweet %>|<%= month.savory %></span
            >
            <% }) %>
          </div>
        </main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/vendor/chart.js/chart.umd.min.js"></script>
    <script>
      const revenueMonths = [...document.querySelectorAll('.revenue-data')].map((item) => {
        const [label, sweet, savory] = item.textContent.split('|');
        return { label, sweet: Number(sweet), savory: Number(savory) };
      });
      const statusCounts = [...document.querySelectorAll('.status-data')].map((item) => {
        const [status, color, count] = item.textContent.split('|');
        return { status, color, count: Number(count) };
      });
      const formatCompactRupiah = (value) => {
        if (value >= 1000000) return `Rp ${(value / 1000000).toFixed(1)}M`;
        if (value >= 1000) return `Rp ${(value / 1000).toFixed(0)}K`;
        return `Rp ${value.toLocaleString('id-ID')}`;
      };

      Chart.defaults.font.family = 'Poppins, sans-serif';
      Chart.defaults.color = '#765b47';

      new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
          labels: revenueMonths.map((month) => month.label),
          datasets: [
            {
              label: 'Sweet',
              data: revenueMonths.map((month) => month.sweet),
              backgroundColor: '#c67d38',
              borderRadius: 7,
              maxBarThickness: 20,
            },
            {
              label: 'Savory',
              data: revenueMonths.map((month) => month.savory),
              backgroundColor: '#7fa27f',
              borderRadius: 7,
              maxBarThickness: 20,
            },
          ],
        },
        options: {
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: (context) => ` ${formatCompactRupiah(context.raw)}` } },
          },
          scales: {
            x: { grid: { display: false }, border: { display: false } },
            y: {
              beginAtZero: true,
              grid: { color: '#eee4d7', borderDash: [4, 4] },
              border: { display: false },
              ticks: { callback: (value) => formatCompactRupiah(value) },
            },
          },
        },
      });

      new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
          labels: statusCounts.map((item) => item.status),
          datasets: [
            {
              data: statusCounts.map((item) => item.count),
              backgroundColor: statusCounts.map((item) => item.color),
              borderColor: '#ffffff',
              borderWidth: 4,
              hoverOffset: 5,
            },
          ],
        },
        options: {
          cutout: '58%',
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
        },
      });
    </script>
    <%- include('../partials/status-modal') %>
  </body>
</html>
