<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title><link rel="stylesheet" href="/css/theme.css"></head><body class="admin-theme"><%- include("../partials/sidebar") %><main class="page-shell admin-content"><h1>Profil Admin</h1><form class="panel profile-form" method="post" action="/dashboard/profile"><div class="avatar"><%= initials %></div><label>Nama lengkap<input name="fullname" value="<%= user.fullname %>" required></label><label>Username<input name="username" value="<%= user.username %>" required></label><label>Email<input type="email" name="email" value="<%= user.email %>" required></label><label>No. telepon<input name="phoneNumber" value="<%= user.phoneNumber %>" required></label><label>Alamat<textarea name="address" required><%= user.address %></textarea></label><label>Password baru (opsional)<input type="password" name="password" minlength="6"></label><button class="btn-brown">Simpan Profil</button></form></main></body></html>
