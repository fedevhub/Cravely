<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications</title><link rel="stylesheet" href="/css/theme.css"></head><body class="admin-theme"><%- include("../partials/sidebar") %><main class="page-shell admin-content"><h1>Notifications</h1><p>Semua pesanan yang masuk akan muncul di sini.</p><% notifications.forEach(item => { %><a class="panel notification" href="<%= item.link %>"><strong><%= item.title %></strong><span><%= item.message %></span><small><%= new Date(item.createdAt).toLocaleString("id-ID") %></small></a><% }) %><% if (!notifications.length) { %><div class="panel">Belum ada notifikasi baru.</div><% } %><% if (whatsappNumber) { %><a class="btn-brown" target="_blank" href="https://wa.me/<%= whatsappNumber %>">Buka WhatsApp Admin</a><% } %></main></body></html>
