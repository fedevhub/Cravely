<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Payment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300..700;1,300..700&family=DM+Serif+Text:ital@0;1&family=Libertinus+Math&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,60 1,700;1,80₀;1,9₀&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/payment.css">
</head>

<body>
    <div class="product-container">
        <%- include('../partials/sidebar') %>

            <div class="main">
                <div class="main-content">
                    <div class="product-management-wrapper">
                        <div class="content-header">
                            <div class="title-section">
                                <h1 class="page-title">Payment Management</h1>
                                <p class="page-subtitle">
                                    <%= payments.length %> payment
                                </p>
                            </div>
                            <button class="btn-primary-custom" data-bs-toggle="modal"
                                data-bs-target="#tambahProdukModal">
                                <i class="fas fa-download"></i> Export Excel
                            </button>
                        </div>

                        <div class="filter-search-row">
                            <div class="filter-tabs">
                                <button class="filter-btn active" data-filter="all">All</button>
                                <button class="filter-btn" data-filter="waiting for payment">
                                    Pending Review
                                </button>
                                <button class="filter-btn" data-filter="payment verification">
                                    Verified
                                </button>
                                <button class="filter-btn" data-filter="confirmed">
                                    Rejected
                                </button>
                            </div>
                        </div>

                        <div class="search-box">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" id="searchInput" placeholder="Search payments..." class="search-input">
                        </div>
                    </div>

                    <div class="scroll-container">
                        <div class="custom-card mb-3 mt-3 card-admin-wrapper">
                            <div class="table-responsive">
                                <table class="table custom-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>PAYMENT ID</th>
                                            <th>ORDER ID</th>
                                            <th>CUSTOMER</th>
                                            <th>METHOD</th>
                                            <th>AMOUNT</th>
                                            <th>SUBMITTED</th>
                                            <th>PROOF</th>
                                            <th>STATUS</th>
                                            <th class="text-end">AKSI</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <% if (payments.length> 0) { %>

                                            <% payments.forEach(payment=> { %>

                                                <tr>

                                                    <!-- PAYMENT ID -->
                                                    <td class="payment-id">
                                                        <%= payment.paymentNumber || '-' %>
                                                    </td>


                                                    <!-- ORDER ID -->
                                                    <td class="order-id">
                                                        <%= payment.order ? payment.order.orderNumber : '-' %>
                                                    </td>


                                                    <!-- CUSTOMER -->
                                                    <td>
                                                        <div class="customer-info">

                                                            <div class="customer-name">
                                                                <%= payment.user ? payment.user.fullname : '-' %>
                                                            </div>

                                                        </div>
                                                    </td>


                                                    <!-- METHOD -->
                                                    <td>
                                                        <div class="payment-method">
                                                            <%= payment.paymentMethod || '-' %>
                                                        </div>
                                                    </td>


                                                    <!-- AMOUNT -->
                                                    <td>
                                                        <div class="payment-amount">
                                                            Rp <%= (payment.amount || 0).toLocaleString("id-ID") %>
                                                        </div>
                                                    </td>


                                                    <!-- SUBMITTED -->
                                                    <td>
                                                        <div class="submitted-date">
                                                            <%= payment.submittedAt ? new
                                                                Date(payment.submittedAt).toLocaleString("en-US", {
                                                                month: "short" , day: "numeric" , hour: "2-digit" ,
                                                                minute: "2-digit" }) : '-' %>
                                                        </div>
                                                    </td>


                                                    <!-- PROOF -->
                                                    <td>



                                                        <button type="button" class="proof-btn" data-bs-toggle="modal"
                                                            data-bs-target="#proofModal<%= payment._id %>">

                                                            <i class="fa-regular fa-eye"></i>


                                                        </button>



                                                    </td>


                                                    <!-- STATUS -->
                                                    <td>

                                                        <% if (payment.status==="Pending Review" ) { %>

                                                            <span class="payment-status pending">
                                                                <i class="fa-regular fa-clock"></i>
                                                                Pending Review
                                                            </span>

                                                            <% } else if (payment.status==="Verify" ) { %>

                                                                <span class="payment-status verified">
                                                                    <i class="fa-regular fa-circle-check"></i>
                                                                    Verified
                                                                </span>

                                                                <% } else if (payment.status==="Reject" ) { %>

                                                                    <span class="payment-status rejected">
                                                                        <i class="fa-regular fa-circle-xmark"></i>
                                                                        Rejected
                                                                    </span>

                                                                    <% } %>

                                                    </td>


                                                    <!-- ACTIONS -->
                                                    <td>

                                                        <div class="payment-actions">

                                                            <!-- VERIFY -->
                                                            <form action="/dashboard/payments/<%= payment._id %>/status"
                                                                method="POST">

                                                                <input type="hidden" name="status" value="Verify">

                                                                <button type="submit" class="action-btn verify-btn">

                                                                    <i class="fa-regular fa-circle-check"></i>
                                                                    Verify

                                                                </button>

                                                            </form>


                                                            <!-- REJECT -->
                                                            <form action="/dashboard/payments/<%= payment._id %>/status"
                                                                method="POST">

                                                                <input type="hidden" name="status" value="Reject">

                                                                <button type="submit" class="action-btn reject-btn">

                                                                    <i class="fa-regular fa-circle-xmark"></i>
                                                                    Reject

                                                                </button>

                                                            </form>

                                                        </div>

                                                    </td>

                                                </tr>


                                                <!-- ========================= -->
                                                <!-- MODAL BUKTI PEMBAYARAN -->
                                                <!-- ========================= -->

                                                <% if (payment.paymentProof) { %>

                                                    <div class="modal fade" id="proofModal<%= payment._id %>"
                                                        tabindex="-1"
                                                        aria-labelledby="proofModalLabel<%= payment._id %>"
                                                        aria-hidden="true">

                                                        <div class="modal-dialog modal-dialog-centered modal-lg">

                                                            <div class="modal-content proof-modal">

                                                                <!-- HEADER -->
                                                                <div class="modal-header">

                                                                    <div>
                                                                        <h5 class="modal-title">
                                                                            Payment Proof
                                                                        </h5>

                                                                        <small class="text-muted">
                                                                            <%= payment.paymentNumber %>
                                                                        </small>
                                                                    </div>

                                                                    <button type="button" class="btn-close"
                                                                        data-bs-dismiss="modal">
                                                                    </button>

                                                                </div>


                                                                <!-- BODY -->
                                                                <div class="modal-body text-center">

                                                                    <img src="/uploads/payment/<%= payment.paymentProof %>"
                                                                        alt="Payment Proof" class="payment-proof-image">

                                                                </div>


                                                                <!-- FOOTER -->
                                                                <div class="modal-footer">

                                                                    <button type="button" class="btn btn-secondary"
                                                                        data-bs-dismiss="modal">

                                                                        Close

                                                                    </button>

                                                                </div>

                                                            </div>

                                                        </div>

                                                    </div>

                                                    <% } %>


                                                        <% }) %>


                                                            <% } else { %>

                                                                <tr>

                                                                    <td colspan="9" class="text-center py-4 text-muted">

                                                                        Belum ada data Payment.

                                                                    </td>

                                                                </tr>

                                                                <% } %>

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>