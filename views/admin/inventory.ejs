<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Inventory | Cravely</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Text&family=Poppins:wght@400;500;600;700&display=swap"><link rel="stylesheet" href="/css/sidebar.css"><link rel="stylesheet" href="/css/admin-pages.css"></head>
<body><div class="dashboard-container"><%- include('../partials/sidebar') %><main class="admin-page"><header class="admin-page-header"><div><p class="eyebrow">OPERATIONS</p><h1>Inventory & Costs</h1><p>Kelola bahan baku, modal awal, dan pengeluaran produksi.</p></div><div class="admin-actions"><button class="admin-button" data-bs-toggle="modal" data-bs-target="#materialModal"><i class="fa-solid fa-plus"></i> Add material</button><button class="admin-button secondary" data-bs-toggle="modal" data-bs-target="#expenseModal"><i class="fa-solid fa-receipt"></i> Record expense</button></div></header>
<section class="admin-stats"><div><span>Material value</span><strong>Rp <%= materials.reduce((sum, item) => sum + item.stock * item.unitCost, 0).toLocaleString('id-ID') %></strong></div><div><span>Low stock</span><strong><%= materials.filter((item) => item.stock <= item.minimumStock).length %></strong></div><div><span>Expenses logged</span><strong>Rp <%= expenses.reduce((sum, item) => sum + item.amount, 0).toLocaleString('id-ID') %></strong></div></section>
<section class="admin-grid"><article class="admin-panel"><div class="panel-title"><h2>Raw materials</h2><span><%= materials.length %> items</span></div><div class="table-wrap"><table><thead><tr><th>Material</th><th>Stock</th><th>Unit cost</th><th>Supplier</th><th>Value</th><th></th></tr></thead><tbody><% if (materials.length) { materials.forEach((item) => { %><tr><td><strong><%= item.name %></strong><small><%= item.unit %></small></td><td><span class="stock-pill <%= item.stock <= item.minimumStock ? 'danger' : '' %>"><%= item.stock %> <%= item.unit %></span></td><td>Rp <%= item.unitCost.toLocaleString('id-ID') %></td><td><%= item.supplier || '-' %></td><td>Rp <%= (item.stock * item.unitCost).toLocaleString('id-ID') %></td><td><button class="icon-button" data-bs-toggle="modal" data-bs-target="#edit-<%= item._id %>"><i class="fa-solid fa-pen"></i></button></td></tr><% }) } else { %><tr><td colspan="6" class="empty-cell">Belum ada bahan baku.</td></tr><% } %></tbody></table></div></article><article class="admin-panel"><div class="panel-title"><h2>Recent expenses</h2></div><div class="expense-list"><% if (expenses.length) { expenses.slice(0, 8).forEach((item) => { %><div class="expense-row"><span class="expense-icon"><i class="fa-solid fa-arrow-trend-down"></i></span><div><strong><%= item.description %></strong><small><%= item.type %> · <%= new Date(item.date).toLocaleDateString('id-ID') %></small></div><b>Rp <%= item.amount.toLocaleString('id-ID') %></b></div><% }) } else { %><p class="empty-cell">Belum ada pengeluaran.</p><% } %></div></article></section></main></div>
<div class="modal fade" id="materialModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="POST" action="/dashboard/inventory/materials"><div class="modal-header"><h5 class="modal-title">Add raw material</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body form-grid"><input name="name" class="form-control" placeholder="Material name" required><input name="unit" class="form-control" placeholder="Unit, e.g. kg" required><input name="stock" type="number" step="0.01" class="form-control" placeholder="Opening stock" required><input name="minimumStock" type="number" step="0.01" class="form-control" placeholder="Minimum stock"><input name="unitCost" type="number" class="form-control" placeholder="Cost per unit" required><input name="supplier" class="form-control" placeholder="Supplier"></div><div class="modal-footer"><button class="admin-button">Save material</button></div></form></div></div>
<div class="modal fade" id="expenseModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="POST" action="/dashboard/inventory/expenses"><div class="modal-header"><h5 class="modal-title">Record expense</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body form-grid"><input name="description" class="form-control" placeholder="Description" required><select name="type" class="form-select"><option value="capital">Initial capital</option><option value="material">Material</option><option value="operational">Operational</option><option value="other">Other</option></select><input name="amount" type="number" class="form-control" placeholder="Amount" required><input name="quantity" type="number" step="0.01" class="form-control" placeholder="Add stock quantity (optional)"></div><div class="modal-footer"><button class="admin-button">Save expense</button></div></form></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
