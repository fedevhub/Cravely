<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Users</title>

    <!-- Icons & Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/users.css">
    <link rel="stylesheet" href="/css/status-modal.css">
</head>

<body>
    <div class="user-container">
        <%- include('../partials/sidebar') %>

            <div class="main">
                <div class="main-content">

                    <!-- FIXED HEADER SECTION -->
                    <div class="page-header d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="page-title">User Management</h1>
                            <p class="page-subtitle">
                                <%= (admins ? admins.length : 0) + (customers ? customers.length : 0) %> total pengguna
                                    terdaftar
                            </p>
                        </div>
                        <div>
                            <button class="btn-primary-custom" data-bs-toggle="modal"
                                data-bs-target="#modalTambahAdmin">
                                <i class="fa-solid fa-plus me-2"></i> Tambah Admin
                            </button>
                        </div>
                    </div>

                    <div
                        class="table-controls-wrapper d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">

                        <!-- SISI KIRI: FILTER ROLE -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <label class="form-label mb-0 fw-bold" style="color: #4b3421; font-size: 13.5px;">
                                Filter:
                            </label>

                            <div class="dropdown">
                                <button
                                    class="btn btn-filter-square dropdown-toggle d-flex align-items-center justify-content-between gap-3"
                                    type="button" id="dropdownRoleBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span id="selectedRoleText">Semua Role</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-brown shadow-sm"
                                    aria-labelledby="dropdownRoleBtn">
                                    <li>
                                        <a class="dropdown-item active" href="javascript:void(0)"
                                            onclick="selectRole('', 'Semua Role', this)">
                                            Semua Role
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:void(0)"
                                            onclick="selectRole('admin', 'Admin', this)">
                                            Admin
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:void(0)"
                                            onclick="selectRole('customer', 'Customer', this)">
                                            Customer
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Input Hidden untuk menyimpan nilai filter yang dipilih -->
                        <input type="hidden" id="filterRole" value="">

                        <!-- SISI KANAN: SEARCH BAR -->
                        <div class="search-input-group">
                            <i class="fas fa-search"></i>
                            <input type="text" id="searchInput" class="form-control" placeholder="Cari data...">
                        </div>

                    </div>

                    <!-- SCROLLABLE AREA -->
                    <div class="scroll-container">

                        <!-- DATA ADMINISTRATOR CARD & TABLE -->
                        <div class="custom-card mb-3 card-admin-wrapper">
                            <div class="card-header-flex">
                                <div>
                                    <h2 class="section-title">
                                        <i class="fa-solid fa-user-shield admin-icon me-2"></i> Data Administrator
                                    </h2>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table custom-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>NAMA LENGKAP</th>
                                            <th>USERNAME</th>
                                            <th>EMAIL</th>
                                            <th>NO. TELEPON</th>
                                            <th>ALAMAT</th>
                                            <th>ROLE</th>
                                            <th class="text-end">AKSI</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (admins && admins.length> 0) { %>
                                            <% admins.forEach(admin=> { %>
                                                <tr>
                                                    <td class="user-fullname">
                                                        <%= admin.fullname %>
                                                    </td>
                                                    <td class="user-username">@<%= admin.username %>
                                                    </td>
                                                    <td>
                                                        <%= admin.email %>
                                                    </td>
                                                    <td>
                                                        <%= admin.phoneNumber || '-' %>
                                                    </td>
                                                    <td class="text-truncate" style="max-width: 200px;">
                                                        <%= admin.address || admin.adress || '-' %>
                                                    </td>
                                                    <td>
                                                        <span class="status-badge badge-admin">
                                                            <%= admin.role || 'Admin' %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="action-group d-flex justify-content-end">
                                                            <button type="button" class="btn-action edit me-1"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalEditAdmin-<%= admin._id %>"
                                                                title="Edit">
                                                                <i class="fa-regular fa-pen-to-square"></i>
                                                            </button>
                                                            <form action="/dashboard/users/delete/<%= admin._id %>"
                                                                method="POST" class="d-inline">
                                                                <button type="button" class="btn-action delete"
                                                                    onclick="confirmDelete('/dashboard/users/delete/<%= admin._id %>', '<%= admin.fullname %>')"
                                                                    title="Hapus">
                                                                    <i class="fa-regular fa-trash-can"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr class="no-data-row">
                                                            <td colspan="7" class="text-center py-4 text-muted">Belum
                                                                ada data Admin.</td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- DATA CUSTOMER CARD & TABLE -->
                        <div class="custom-card card-customer-wrapper">
                            <div class="card-header-flex">
                                <div>
                                    <h2 class="section-title">
                                        <i class="fa-solid fa-users customer-icon me-2"></i> Data Pelanggan (Customer)
                                    </h2>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table custom-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>NAMA LENGKAP</th>
                                            <th>USERNAME</th>
                                            <th>EMAIL</th>
                                            <th>NO. TELEPON</th>
                                            <th>ALAMAT</th>
                                            <th>ROLE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (customers && customers.length> 0) { %>
                                            <% customers.forEach(customer=> { %>
                                                <tr>
                                                    <td class="user-fullname">
                                                        <%= customer.fullname %>
                                                    </td>
                                                    <td class="user-username">@<%= customer.username %>
                                                    </td>
                                                    <td>
                                                        <%= customer.email %>
                                                    </td>
                                                    <td>
                                                        <%= customer.phoneNumber || '-' %>
                                                    </td>
                                                    <td class="text-truncate" style="max-width: 250px;">
                                                        <%= customer.address || customer.adress || '-' %>
                                                    </td>
                                                    <td>
                                                        <span class="status-badge badge-customer">Customer</span>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr class="no-data-row">
                                                            <td colspan="6" class="text-center py-4 text-muted">Belum
                                                                ada data Customer.</td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div> <!-- End Scroll Container -->
                </div>
            </div>
    </div>

    <!-- MODAL EDIT ADMIN -->
    <% if (admins && admins.length> 0) { %>
        <% admins.forEach(admin=> { %>
            <div class="modal fade" id="modalEditAdmin-<%= admin._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Admin</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            <form action="/dashboard/users/edit/<%= admin._id %>" method="POST">
                                <div class="mb-3">
                                    <label class="form-label">Nama Lengkap</label>
                                    <input type="text" class="form-control" name="fullname"
                                        value="<%= admin.fullname %>" placeholder="Masukkan nama lengkap" required>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Username</label>
                                        <input type="text" class="form-control" name="username"
                                            value="<%= admin.username %>" placeholder="Username" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control" name="email" value="<%= admin.email %>"
                                            placeholder="nama@email.com" required>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Role / Peran</label>
                                        <select class="form-select" name="role" required>
                                            <option value="admin" <%=(admin.role==='admin' ) ? 'selected' : '' %>>Admin
                                            </option>
                                            <option value="customer" <%=(admin.role==='customer' ) ? 'selected' : '' %>
                                                >Customer</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">No. Telepon</label>
                                        <input type="tel" class="form-control" name="phoneNumber"
                                            value="<%= admin.phoneNumber || '' %>" placeholder="08123456789">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Alamat</label>
                                    <textarea class="form-control" name="address" rows="3"
                                        placeholder="Alamat lengkap..."><%= admin.address || admin.adress || '' %></textarea>
                                </div>

                                <div class="modal-actions">
                                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Batal</button>
                                    <button type="submit" class="btn-submit">
                                        <i class="fas fa-save"></i> Simpan
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
                <% } %>

                    <!-- MODAL TAMBAH ADMIN -->
                    <div class="modal fade" id="modalTambahAdmin" tabindex="-1" aria-labelledby="modalTambahUserLabel"
                        aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalTambahUserLabel">Tambah Admin Baru</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>

                                <div class="modal-body">
                                    <form action="/dashboard/users/tambah" method="POST">
                                        <div class="mb-3">
                                            <label for="fullname" class="form-label">Nama Lengkap</label>
                                            <input type="text" class="form-control" id="fullname" name="fullname"
                                                placeholder="Masukkan nama lengkap" required>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="username" class="form-label">Username</label>
                                                <input type="text" class="form-control" id="username" name="username"
                                                    placeholder="Username" required>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="email" class="form-label">Email</label>
                                                <input type="email" class="form-control" id="email" name="email"
                                                    placeholder="nama@email.com" required>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="password" class="form-label">Password</label>
                                                <input type="password" class="form-control" id="password"
                                                    name="password" placeholder="******" required>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="role" class="form-label">Role / Peran</label>
                                                <select class="form-select" id="role" name="role" required>
                                                    <option value="admin" selected>Admin</option>
                                                    <option value="customer">Customer</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="phoneNumber" class="form-label">No. Telepon</label>
                                            <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                                                placeholder="08123456789">
                                        </div>

                                        <div class="mb-3">
                                            <label for="address" class="form-label">Alamat</label>
                                            <textarea class="form-control" id="address" name="address" rows="3"
                                                placeholder="Alamat lengkap..."></textarea>
                                        </div>

                                        <div class="modal-actions">
                                            <button type="button" class="btn-cancel"
                                                data-bs-dismiss="modal">Batal</button>
                                            <button type="submit" class="btn-submit">
                                                <i class="fas fa-save"></i> Simpan
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade confirm-modal" id="modalConfirmDelete" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-body">
                                    <button type="button" class="confirm-modal-close" data-bs-dismiss="modal" aria-label="Close">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                    <span class="confirm-modal-spark one"></span>
                                    <span class="confirm-modal-spark two"></span>
                    
                                    <div class="confirm-modal-icon">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </div>
                    
                                    <h2 class="confirm-modal-title">Hapus Data?</h2>
                                    <p class="confirm-modal-message">
                                        Apakah kamu yakin ingin menghapus data <strong id="deleteUserName" style="color: #4b3421;">user
                                            ini</strong>?
                                    </p>
                    
                                    <div class="confirm-modal-actions">
                                        <button type="button" class="btn-confirm-cancel" data-bs-dismiss="modal">Batal</button>
                                        <form id="formDeleteUser" method="POST" action="" style="margin: 0;">
                                            <button type="submit" class="btn-confirm-delete">
                                                Ya, Hapus
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                    <%- include('../partials/status-modal') %>

                        <% if (typeof editUser !=='undefined' && editUser) { %>
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                    var editModalElement = document.getElementById('modalEditUser');
                                    if (editModalElement) {
                                        var myModal = new bootstrap.Modal(editModalElement, {
                                            keyboard: false,
                                            backdrop: 'static'
                                        });
                                        myModal.show();
                                    }
                                });
                            </script>
                            <% } %>

                                <!-- SCRIPT FILTER DAN SEARCH -->
                                <script>
                                    // Fungsi untuk memilih Role pada Dropdown Filter
                                    function selectRole(roleValue, roleLabel, element) {
                                        document.getElementById('filterRole').value = roleValue;
                                        document.getElementById('selectedRoleText').textContent = roleLabel;

                                        // Highlight item aktif
                                        const items = document.querySelectorAll('.dropdown-menu-brown .dropdown-item');
                                        items.forEach(item => item.classList.remove('active'));
                                        if (element) element.classList.add('active');

                                        // Jalankan filter
                                        filterTable();
                                    }

                                    // Fungsi Utama Filter dan Search Table
                                    function filterTable() {
                                        const searchInput = document.getElementById('searchInput');
                                        const filterRoleInput = document.getElementById('filterRole');

                                        const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
                                        const selectedRole = filterRoleInput ? filterRoleInput.value.toLowerCase().trim() : '';

                                        // Ambil semua baris data (kecuali baris "Belum ada data")
                                        const tableRows = document.querySelectorAll('.custom-table tbody tr:not(.no-data-row)');

                                        tableRows.forEach(row => {
                                            const rowText = row.textContent.toLowerCase();

                                            // Ambil teks dari kolom Role (kolom ke-6)
                                            const roleCell = row.querySelector('td:nth-child(6)');
                                            let roleText = roleCell ? roleCell.textContent.toLowerCase().replace(/\s+/g, '').trim() : '';

                                            // Normalisasi pencocokan role
                                            let matchesRole = false;
                                            if (selectedRole === '') {
                                                matchesRole = true;
                                            } else if (selectedRole === 'admin') {
                                                matchesRole = roleText === 'admin';
                                            } else if (selectedRole === 'customer') {
                                                matchesRole = roleText === 'customer';
                                            } else {
                                                matchesRole = roleText.includes(selectedRole);
                                            }

                                            // Pencocokan Search
                                            const matchesSearch = searchTerm === '' || rowText.includes(searchTerm);

                                            // Tampilkan atau Sembunyikan Baris
                                            if (matchesSearch && matchesRole) {
                                                row.style.display = '';
                                            } else {
                                                row.style.display = 'none';
                                            }
                                        });
                                    }

                                    // Event Listener saat halaman selesai di-load
                                    document.addEventListener('DOMContentLoaded', function () {
                                        const searchInput = document.getElementById('searchInput');
                                        if (searchInput) {
                                            searchInput.addEventListener('input', filterTable);
                                        }
                                    });
                                </script>

                                <script>
                                    function confirmDelete(deleteUrl, userName) {
                                        const formDelete = document.getElementById('formDeleteUser');
                                        const userNameElem = document.getElementById('deleteUserName');

                                        // Set URL Hapus pada Form
                                        if (formDelete) {
                                            formDelete.action = deleteUrl;
                                        }

                                        // Set Nama User yang akan dihapus
                                        if (userNameElem) {
                                            userNameElem.textContent = userName ? `"${userName}"` : 'user ini';
                                        }

                                        // Tampilkan Modal Bootstrap
                                        const deleteModal = new bootstrap.Modal(document.getElementById('modalConfirmDelete'));
                                        deleteModal.show();
                                    }
                                </script>
</body>

</html>