<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reviews | Cravely</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Text&family=Poppins:wght@400;500;600;700&display=swap"><link rel="stylesheet" href="/css/sidebar.css"><link rel="stylesheet" href="/css/admin-pages.css"></head><body><div class="dashboard-container"><%- include('../partials/sidebar') %><main class="admin-page"><header class="admin-page-header"><div><p class="eyebrow">CUSTOMER VOICE</p><h1>Reviews</h1><p>Lihat ulasan customer dan jaga kualitas setiap produk.</p></div><div class="review-score"><strong><%= average ? average.toFixed(1) : '0.0' %></strong><span><i class="fa-solid fa-star"></i> average from <%= reviews.length %> reviews</span></div></header><section class="admin-panel reviews-panel"><% if (reviews.length) { reviews.forEach((review) => { %><article class="review-admin-row"><div class="review-avatar"><%= (review.user?.fullname || 'C').slice(0, 1).toUpperCase() %></div><div class="review-admin-content"><div class="review-admin-head"><div><strong><%= review.user?.fullname || 'Customer' %></strong><small><%= review.product?.name || 'Product' %> · <%= new Date(review.createdAt).toLocaleDateString('id-ID') %></small></div><span class="stars"><% for (let star = 1; star <= 5; star++) { %><i class="fa-<%= star <= review.rating ? 'solid' : 'regular' %> fa-star"></i><% } %></span></div><p><%= review.comment %></p></div><form method="POST" action="/dashboard/reviews/<%= review._id %>/toggle"><button class="review-status <%= review.status %>" type="submit"><%= review.status === 'published' ? 'Published' : 'Hidden' %></button></form></article><% }) } else { %><div class="empty-cell">Belum ada review dari customer.</div><% } %></section></main></div></body></html>
