<!-- Modal Konfirmasi Save — gaya sama dengan status-modal -->
<style>
  .confirm-modal .modal-dialog {
    max-width: 310px;
  }

  .confirm-modal .modal-content {
    border: 1px solid rgba(193, 125, 60, 0.16);
    border-radius: 16px;
    overflow: hidden;
    background: #fffdf8;
    box-shadow: 0 18px 48px rgba(61, 43, 26, 0.24);
  }

  .confirm-modal .modal-body {
    position: relative;
    padding: 26px 24px 22px;
    text-align: center;
    isolation: isolate;
    background: linear-gradient(180deg, rgba(255, 248, 238, 0.86), rgba(255, 253, 248, 0.98));
  }

  .confirm-modal .modal-body::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42px;
    background: linear-gradient(
      90deg,
      transparent 0 10%,
      rgba(111, 150, 79, 0.16) 10% 26%,
      transparent 26% 34%,
      rgba(111, 150, 79, 0.16) 34% 58%,
      transparent 58% 66%,
      rgba(111, 150, 79, 0.16) 66% 90%,
      transparent 90% 100%
    );
    opacity: 0.46;
    z-index: -2;
    pointer-events: none;
  }

  .confirm-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #8f6f4f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    z-index: 2;
  }

  .confirm-modal-icon {
    position: relative;
    width: 58px;
    height: 58px;
    margin: 4px auto 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #eaf3dc;
    font-size: 23px;
    background: rgba(193, 125, 60, 0.08);
    box-shadow:
      0 0 0 8px rgba(193, 125, 60, 0.06),
      0 12px 24px rgba(61, 43, 26, 0.1);
  }

  .confirm-modal-icon::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background: linear-gradient(180deg, #4f7f42, #2f5f32);
    box-shadow:
      inset 0 -5px 10px rgba(0, 0, 0, 0.12),
      0 8px 16px rgba(79, 127, 66, 0.18);
    z-index: -1;
  }

  .confirm-modal-spark {
    position: absolute;
    width: 5px;
    height: 5px;
    color: #c9ae8a;
    opacity: 0.6;
    z-index: 1;
  }

  .confirm-modal-spark::before,
  .confirm-modal-spark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
    border-radius: 999px;
  }

  .confirm-modal-spark::before {
    width: 2px;
    height: 100%;
  }

  .confirm-modal-spark::after {
    width: 100%;
    height: 2px;
  }

  .confirm-modal-spark.one {
    top: 50px;
    left: 84px;
  }

  .confirm-modal-spark.two {
    top: 62px;
    right: 82px;
    transform: scale(0.78);
  }

  .confirm-modal-title {
    margin: 0 0 8px;
    color: #2f5f32;
    font-family: 'DM Serif Text', Georgia, 'Times New Roman', serif;
    font-size: 26px;
    line-height: 1;
    font-weight: 400;
  }

  .confirm-modal-message {
    margin: 0 auto 18px;
    color: #6f563e;
    font-size: 13px;
    line-height: 1.48;
    max-width: 230px;
  }

  .confirm-modal-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .confirm-modal-button {
    min-width: 108px;
    border: 0;
    border-radius: 10px;
    background: linear-gradient(180deg, #4f7f42, #2f5f32);
    color: #fff;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 10px 18px rgba(79, 127, 66, 0.18);
    transition: transform 0.18s ease;
  }

  .confirm-modal-button:hover {
    transform: translateY(-1px);
    color: #fff;
  }

  .confirm-modal-button.cancel {
    background: #fff;
    color: #8f6f4f;
    border: 1px solid rgba(193, 125, 60, 0.3);
    box-shadow: none;
  }
</style>

<div class="modal fade confirm-modal" id="confirmSaveModal" tabindex="-1" aria-hidden="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <button
          type="button"
          class="confirm-modal-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>
        <span class="confirm-modal-spark one"></span>
        <span class="confirm-modal-spark two"></span>
        <div class="confirm-modal-icon">
          <i class="fa-solid fa-circle-question"></i>
        </div>
        <h2 class="confirm-modal-title">Confirm</h2>
        <p class="confirm-modal-message" id="confirmSaveMessage">
          Apakah kamu yakin ingin menyimpan perubahan ini?
        </p>
        <div class="confirm-modal-actions">
          <button type="button" class="confirm-modal-button cancel" data-bs-dismiss="modal">
            Batal
          </button>
          <button type="button" class="confirm-modal-button" id="confirmSaveOk">Ya, Simpan</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const confirmModalElement = document.getElementById('confirmSaveModal');

    if (!confirmModalElement || !window.bootstrap) return;

    const confirmModal = new bootstrap.Modal(confirmModalElement);

    let pendingForm = null;

    // Semua form yang membutuhkan konfirmasi
    document.querySelectorAll('form.needs-confirm').forEach((form) => {
      form.addEventListener('submit', function (event) {
        event.preventDefault();

        pendingForm = form;

        const message =
          form.dataset.confirmMessage ||
          'Apakah kamu yakin ingin menyimpan perubahan ini?';

        document.getElementById('confirmSaveMessage').textContent = message;

        confirmModal.show();
      });
    });

    // Tombol Ya, Simpan
    document.getElementById('confirmSaveOk').addEventListener('click', function () {
      if (!pendingForm) return;

      const form = pendingForm;
      pendingForm = null;

      // Lepaskan focus dari tombol
      this.blur();

      // Tutup modal
      confirmModal.hide();

      // Tunggu modal selesai ditutup
      confirmModalElement.addEventListener(
        'hidden.bs.modal',
        function () {
          // SUBMIT LANGSUNG TANPA MEMICU EVENT .needs-confirm
          HTMLFormElement.prototype.submit.call(form);
        },
        { once: true }
      );
    });
  });
</script>
