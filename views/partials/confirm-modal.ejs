<!-- Modal Konfirmasi -->
<style>
    .confirm-modal .modal-dialog {
        max-width: 310px;
    }
    
    .confirm-modal .modal-content {
        border: 1px solid rgba(193, 125, 60, 0.16);
        border-radius: 16px;
        overflow: hidden;
        background: #fffdf8;
        box-shadow: 0 18px 48px rgba(61, 43, 26, 0.24);
    }
    
    .confirm-modal .modal-body {
        position: relative;
        padding: 26px 24px 22px;
        text-align: center;
        isolation: isolate;
        --confirm-main: #d5a34a;
        --confirm-deep: #9a681f;
        --confirm-soft: rgba(213, 163, 74, 0.16);
        --confirm-glow: rgba(213, 163, 74, 0.18);
        background: linear-gradient( 180deg, rgba(255, 248, 238, 0.86), rgba(255, 253, 248, 0.98));
    }
    /* =========================
     WARNING / TAMBAH / EDIT
     ========================= */
    
    .confirm-modal.warning .modal-body {
        --confirm-main: #d5a34a;
        --confirm-deep: #9a681f;
        --confirm-soft: rgba(213, 163, 74, 0.16);
        --confirm-glow: rgba(213, 163, 74, 0.18);
    }
    /* =========================
     DANGER / DELETE
     ========================= */
    
    .confirm-modal.danger .modal-body {
        --confirm-main: #c94b3c;
        --confirm-deep: #8f2f25;
        --confirm-soft: rgba(201, 75, 60, 0.15);
        --confirm-glow: rgba(201, 75, 60, 0.2);
    }
    
    .confirm-modal .modal-body::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 42px;
        background: linear-gradient( 90deg, transparent 0 10%, var(--confirm-soft) 10% 26%, transparent 26% 34%, var(--confirm-soft) 34% 58%, transparent 58% 66%, var(--confirm-soft) 66% 90%, transparent 90% 100%);
        opacity: 0.46;
        z-index: -2;
        pointer-events: none;
    }
    /* =========================
     CLOSE BUTTON
     ========================= */
    
    .confirm-modal-close {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 24px;
        height: 24px;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #8f6f4f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        z-index: 2;
        transition: background 0.18s ease, color 0.18s ease;
    }
    
    .confirm-modal-close:hover {
        background: rgba(143, 111, 79, 0.08);
        color: #5f4630;
    }
    /* =========================
     ICON
     ========================= */
    
    .confirm-modal-icon {
        position: relative;
        width: 58px;
        height: 58px;
        margin: 4px auto 16px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 23px;
        background: var(--confirm-soft);
        box-shadow: 0 0 0 8px var(--confirm-soft), 0 12px 24px rgba(61, 43, 26, 0.1);
    }
    
    .confirm-modal-icon::after {
        content: '';
        position: absolute;
        inset: 7px;
        border-radius: 50%;
        background: linear-gradient( 180deg, var(--confirm-main), var(--confirm-deep));
        box-shadow: inset 0 -5px 10px rgba(0, 0, 0, 0.12), 0 8px 16px var(--confirm-glow);
        z-index: -1;
    }
    /* =========================
     SPARK
     ========================= */
    
    .confirm-modal-spark {
        position: absolute;
        width: 5px;
        height: 5px;
        color: #c9ae8a;
        opacity: 0.6;
        z-index: 1;
    }
    
    .confirm-modal-spark::before,
    .confirm-modal-spark::after {
        content: '';
        position: absolute;
        inset: 0;
        margin: auto;
        background: currentColor;
        border-radius: 999px;
    }
    
    .confirm-modal-spark::before {
        width: 2px;
        height: 100%;
    }
    
    .confirm-modal-spark::after {
        width: 100%;
        height: 2px;
    }
    
    .confirm-modal-spark.one {
        top: 50px;
        left: 84px;
    }
    
    .confirm-modal-spark.two {
        top: 62px;
        right: 82px;
        transform: scale(0.78);
    }
    /* =========================
     TITLE
     ========================= */
    
    .confirm-modal-title {
        margin: 0 0 8px;
        color: var(--confirm-deep);
        font-family: 'DM Serif Text', Georgia, 'Times New Roman', serif;
        font-size: 26px;
        line-height: 1;
        font-weight: 400;
    }
    /* =========================
     MESSAGE
     ========================= */
    
    .confirm-modal-message {
        margin: 0 auto 18px;
        color: #6f563e;
        font-size: 13px;
        line-height: 1.48;
        max-width: 230px;
    }
    /* =========================
     ACTIONS
     ========================= */
    
    .confirm-modal-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }
    /* =========================
     MAIN BUTTON
     ========================= */
    
    .confirm-modal-button {
        min-width: 108px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient( 180deg, var(--confirm-main), var(--confirm-deep));
        color: #fff;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 10px 18px var(--confirm-glow);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    
    .confirm-modal-button:hover {
        transform: translateY(-1px);
        color: #fff;
        box-shadow: 0 12px 20px var(--confirm-glow);
    }
    /* =========================
     CANCEL BUTTON
     ========================= */
    
    .confirm-modal-button.cancel {
        background: #fff;
        color: #8f6f4f;
        border: 1px solid rgba(193, 125, 60, 0.3);
        box-shadow: none;
    }
    
    .confirm-modal-button.cancel:hover {
        background: #fffaf3;
        color: #6f563e;
        border-color: rgba(193, 125, 60, 0.45);
        box-shadow: none;
        transform: translateY(-1px);
    }
</style>

<!-- =========================
     CONFIRM MODAL
     ========================= -->

<div class="modal fade confirm-modal" id="confirmSaveModal" tabindex="-1" aria-labelledby="confirmSaveTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <!-- Close -->
                <button type="button" class="confirm-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>

                <!-- Decorative Spark -->
                <span class="confirm-modal-spark one"></span>
                <span class="confirm-modal-spark two"></span>

                <!-- Icon -->
                <div class="confirm-modal-icon" id="confirmSaveIcon">
                    <i class="fa-solid fa-circle-question"></i>
                </div>

                <!-- Title -->
                <h2 class="confirm-modal-title" id="confirmSaveTitle">
                    Konfirmasi
                </h2>

                <!-- Message -->
                <p class="confirm-modal-message" id="confirmSaveMessage">
                    Apakah kamu yakin ingin melanjutkan?
                </p>

                <!-- Buttons -->
                <div class="confirm-modal-actions">
                    <button type="button" class="confirm-modal-button cancel" data-bs-dismiss="modal">
            Batal
          </button>

                    <button type="button" class="confirm-modal-button" id="confirmSaveOk">
            Ya, Simpan
          </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================
     CONFIRM MODAL SCRIPT
     ========================= -->

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const confirmModalElement =
            document.getElementById('confirmSaveModal');

        if (!confirmModalElement || !window.bootstrap) {
            return;
        }

        const confirmModal =
            new bootstrap.Modal(confirmModalElement);

        const confirmMessage =
            document.getElementById('confirmSaveMessage');

        const confirmTitle =
            document.getElementById('confirmSaveTitle');

        const confirmIcon =
            document.querySelector('#confirmSaveIcon i');

        const confirmButton =
            document.getElementById('confirmSaveOk');

        let pendingForm = null;

        /*
         * Semua form yang membutuhkan konfirmasi
         */
        document
            .querySelectorAll('form.needs-confirm')
            .forEach((form) => {
                form.addEventListener('submit', function(event) {
                    event.preventDefault();

                    pendingForm = form;

                    const message =
                        form.dataset.confirmMessage ||
                        'Apakah kamu yakin ingin melanjutkan?';

                    const type =
                        form.dataset.confirmType ||
                        'warning';

                    /*
                     * Reset class modal
                     */
                    confirmModalElement.classList.remove(
                        'warning',
                        'danger'
                    );

                    /*
                     * =========================
                     * DELETE
                     * =========================
                     */

                    if (type === 'danger') {
                        confirmModalElement.classList.add('danger');

                        confirmTitle.textContent =
                            'Hapus Produk?';

                        confirmIcon.className =
                            'fa-solid fa-trash-can';

                        confirmButton.textContent =
                            'Ya, Hapus';
                    }

                    /*
                     * =========================
                     * TAMBAH / EDIT
                     * =========================
                     */
                    else {
                        confirmModalElement.classList.add(
                            'warning'
                        );

                        confirmTitle.textContent =
                            'Konfirmasi';

                        confirmIcon.className =
                            'fa-solid fa-circle-question';

                        confirmButton.textContent =
                            'Ya, Simpan';
                    }

                    /*
                     * Set pesan berdasarkan form
                     */
                    confirmMessage.textContent = message;

                    /*
                     * Tampilkan modal
                     */
                    confirmModal.show();
                });
            });

        /*
         * =========================
         * TOMBOL KONFIRMASI
         * =========================
         */

        confirmButton.addEventListener(
            'click',
            function() {
                if (!pendingForm) {
                    return;
                }

                const form = pendingForm;

                pendingForm = null;

                /*
                 * Lepaskan focus dari tombol
                 */
                this.blur();

                /*
                 * Tutup modal terlebih dahulu
                 */
                confirmModal.hide();

                /*
                 * Tunggu sampai modal benar-benar tertutup
                 */
                confirmModalElement.addEventListener(
                    'hidden.bs.modal',
                    function() {
                        /*
                         * Submit langsung tanpa
                         * memicu event .needs-confirm
                         */
                        HTMLFormElement.prototype.submit.call(
                            form
                        );
                    }, {
                        once: true,
                    }
                );
            }
        );
    });
</script>