<nav class="navbar navbar-expand-lg custom-navbar">
  <div class="container-fluid px-4">
    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center gap-3" href="/customer/home">
      <div class="logo-circle">C</div>
      <span class="brand-name"> Cravely </span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarMenu"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-center" id="navbarMenu">
      <ul class="navbar-nav gap-lg-4">
        <li class="nav-item">
          <a
            class="nav-link <%= currentPage === 'home' ? 'active-pill' : '' %>"
            href="/customer/home"
            >Home</a
          >
        </li>
        <li class="nav-item">
          <a
            class="nav-link <%= currentPage === 'sweet' ? 'active-pill' : '' %>"
            href="/customer/products?category=sweet"
            >Sweet Corner</a
          >
        </li>
        <li class="nav-item">
          <a
            class="nav-link <%= currentPage === 'savory' ? 'active-pill' : '' %>"
            href="/customer/products?category=savory"
            >Savory Corner</a
          >
        </li>
      </ul>
    </div>
    <!-- Icons -->
    <div class="d-flex align-items-center gap-4 nav-icons">
      <a href="/customer/wishlist" class="nav-icon-link position-relative" title="Wishlist">
        <i class="bi <%= wishlistCount > 0 ? 'bi-heart-fill text-danger' : 'bi-heart' %>"></i>
        <% if (wishlistCount > 0) { %>
        <span class="navbar-badge wishlist-badge"><%= wishlistCount %></span>
        <% } %>
      </a>
      <a
        href="<%= isPreOrderOpen ? '/customer/cart' : '#' %>"
        class="<%= isPreOrderOpen ? '' : 'order-disabled-link' %>"
        aria-disabled="<%= isPreOrderOpen ? 'false' : 'true' %>"
        title="<%= isPreOrderOpen ? 'Cart' : 'Pre-order sedang ditutup' %>"
      >
        <i class="bi bi-cart3"></i>
        <% if (cartCount > 0) { %>
        <span class="navbar-badge cart-badge"><%= cartCount %></span>
        <% } %>
      </a>
      <a href="/profile">
        <i class="bi bi-person"></i>
      </a>
      <a href="/customer/history" title="Order history">
        <i class="bi bi-clock-history"></i>
      </a>
      <a
        href="/auth/logout"
        class="btn btn-sm btn-outline-danger temporary-logout"
        onclick="return confirm('Yakin ingin logout?');"
      >
        Logout
      </a>
    </div>
  </div>
</nav>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const navbar = document.querySelector('.custom-navbar');

    if (!navbar) {
      return;
    }

    function updateNavbarBackground() {
      navbar.classList.toggle('is-scrolled', window.scrollY > 8);
    }

    updateNavbarBackground();
    window.addEventListener('scroll', updateNavbarBackground, {
      passive: true,
    });
  });
</script>
