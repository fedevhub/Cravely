        </button>
        <div class="collapse navbar-collapse justify-content-center" id="navbarMenu">
            <ul class="navbar-nav gap-lg-4">
                <li class="nav-item">
                    <a class="nav-link <%= currentPage === 'home' ? 'active-pill' : '' %>" href="/customer/home">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage === 'sweet' ? 'active-pill' : '' %>" href="/customer/products?category=sweet">Sweet Corner</a>
