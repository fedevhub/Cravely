<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg custom-navbar">
    <div class="container-fluid px-4">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center gap-3" href="/">
            <div class="logo-circle">
                C
            </div>
            <span class="brand-name">
                Cravely
            </span>
        </a>
        <!-- Toggle Mobile -->
        <button
            class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"><span class="navbar-toggler-icon"></span>
        </button>
        <!-- Menu -->
        <div class="collapse navbar-collapse justify-content-center" id="navbarMenu">
            <ul class="navbar-nav gap-lg-4">
                <li class="nav-item">
                    <a class="nav-link <%= currentPage === 'home' ? 'active-pill' : '' %>" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage === 'sweet' ? 'active-pill' : '' %>" href="/sweet_corner">Sweet Corner</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage === 'savory' ? 'active-pill' : '' %>" href="/savory_corner">Savory Corner</a>
                </li>
            </ul>
        </div>
        <!-- Icons -->
        <div class="d-flex align-items-center gap-4 nav-icons">
            <a href="#">
                <i class="bi bi-search"></i>
            </a>
            <a href="#">
                <i class="bi bi-heart"></i>
            </a>
            <a href="#">
                <i class="bi bi-cart3"></i>
            </a>
            <a href="#">
                <i class="bi bi-person"></i>
            </a>
        </div>
    </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>    
</body>
</html>