<% const modalData = typeof error !== "undefined" && error ? { type: "error", title: "Gagal",
message: error } : typeof flash !== "undefined" && flash ? flash : null; const modalType = modalData
? modalData.type : "info"; const modalIcon = modalType === "success" ? "fa-check" : modalType ===
"error" ? "fa-triangle-exclamation" : "fa-circle-info"; const modalButtonText = modalType ===
"success" ? "Continue" : modalType === "error" ? "Try Again" : "Okay"; const modalLabel = modalType
=== "success" ? "Success" : modalType === "error" ? "Check Again" : modalData ? modalData.title :
"Info"; %> <% if (modalData) { %>
<style>
  .status-modal .modal-dialog {
    max-width: 310px;
  }

  .status-modal .modal-content {
    border: 1px solid rgba(193, 125, 60, 0.16);
    border-radius: 16px;
    overflow: hidden;
    background: #fffdf8;
    box-shadow: 0 18px 48px rgba(61, 43, 26, 0.24);
  }

  .status-modal .modal-body {
    position: relative;
    padding: 26px 24px 22px;
    text-align: center;
    isolation: isolate;
  }

  .status-modal .modal-body::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 248, 238, 0.86), rgba(255, 253, 248, 0.98));
    z-index: -3;
    pointer-events: none;
  }

  .status-modal .modal-body::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42px;
    background: linear-gradient(
      90deg,
      transparent 0 10%,
      var(--status-soft) 10% 26%,
      transparent 26% 34%,
      var(--status-soft) 34% 58%,
      transparent 58% 66%,
      var(--status-soft) 66% 90%,
      transparent 90% 100%
    );
    opacity: 0.46;
    z-index: -2;
    pointer-events: none;
  }

  .status-modal.success .modal-body {
    --status-main: #4f7f42;
    --status-deep: #2f5f32;
    --status-soft: rgba(111, 150, 79, 0.16);
    --status-glow: rgba(79, 127, 66, 0.18);
  }

  .status-modal.error .modal-body {
    --status-main: #b85c38;
    --status-deep: #7b341c;
    --status-soft: rgba(184, 92, 56, 0.14);
    --status-glow: rgba(184, 92, 56, 0.18);
  }

  .status-modal.info .modal-body {
    --status-main: #8a4316;
    --status-deep: #612909;
    --status-soft: rgba(220, 157, 89, 0.24);
    --status-glow: rgba(138, 67, 22, 0.18);
  }

  .status-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #8f6f4f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    z-index: 2;
  }

  .status-modal-icon {
    position: relative;
    width: 58px;
    height: 58px;
    margin: 4px auto 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 23px;
    background: rgba(193, 125, 60, 0.08);
    box-shadow:
      0 0 0 8px rgba(193, 125, 60, 0.06),
      0 12px 24px rgba(61, 43, 26, 0.1);
  }

  .status-modal-icon::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background: var(--status-main);
    box-shadow:
      inset 0 -5px 10px rgba(0, 0, 0, 0.12),
      0 8px 16px var(--status-glow);
    z-index: -1;
  }

  .status-modal-icon.success {
    color: #eaf3dc;
  }

  .status-modal-icon.error {
    color: #ffe9df;
  }

  .status-modal-icon.info {
    color: #ffe5bd;
  }

  .status-modal-spark {
    position: absolute;
    width: 5px;
    height: 5px;
    color: #c9ae8a;
    opacity: 0.6;
    z-index: 1;
  }

  .status-modal-spark::before,
  .status-modal-spark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
    border-radius: 999px;
  }

  .status-modal-spark::before {
    width: 2px;
    height: 100%;
  }

  .status-modal-spark::after {
    width: 100%;
    height: 2px;
  }

  .status-modal-spark.one {
    top: 50px;
    left: 84px;
  }

  .status-modal-spark.two {
    top: 62px;
    right: 82px;
    transform: scale(0.78);
  }

  .status-modal-title {
    margin: 0 0 8px;
    color: var(--status-deep);
    font-family: 'DM Serif Text', Georgia, 'Times New Roman', serif;
    font-size: 26px;
    line-height: 1;
    font-weight: 400;
  }

  .status-modal-message {
    margin: 0 auto 18px;
    color: #6f563e;
    font-size: 13px;
    line-height: 1.48;
    max-width: 230px;
  }

  .status-modal-button {
    min-width: 116px;
    border: 0;
    border-radius: 10px;
    background: linear-gradient(180deg, var(--status-main), var(--status-deep));
    color: #fff;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 10px 18px var(--status-glow);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .status-modal-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 20px var(--status-glow);
  }
</style>

<div
  class="modal fade status-modal <%= modalType %>"
  id="statusModal"
  tabindex="-1"
  aria-labelledby="statusModalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <button type="button" class="status-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <span class="status-modal-spark one"></span>
        <span class="status-modal-spark two"></span>
        <div class="status-modal-icon <%= modalType %>">
          <i class="fa-solid <%= modalIcon %>"></i>
        </div>
        <h2 class="status-modal-title" id="statusModalTitle"><%= modalLabel %></h2>
        <p class="status-modal-message"><%= modalData.message %></p>
        <button type="button" class="status-modal-button" data-bs-dismiss="modal">
          <%= modalButtonText %>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modalElement = document.getElementById('statusModal');

    if (!modalElement || !window.bootstrap) return;

    const statusModal = new bootstrap.Modal(modalElement);

    // Saat modal selesai ditutup, lepaskan focus dari elemen di dalam modal
    modalElement.addEventListener('hidden.bs.modal', () => {
      if (document.activeElement && modalElement.contains(document.activeElement)) {
        document.activeElement.blur();
      }
    });

    statusModal.show();
  });
</script>
<% } %>
