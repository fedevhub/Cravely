<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Shopping Cart | Cravely</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="/css/home.css"><link rel="stylesheet" href="/css/customer-pages.css"></head>
<body class="customer-page"><%- include('../partials/navbar') %><main class="reference-page cart-reference"><a class="reference-back" href="/customer/products"><i class="fa-solid fa-chevron-left"></i> Continue Shopping</a><h1>Shopping Cart <small>(<%= cart.reduce((sum, item) => sum + item.quantity, 0) %> item<%= cart.reduce((sum, item) => sum + item.quantity, 0) === 1 ? '' : 's' %>)</small></h1><% if (!cart.length) { %><section class="empty-reference"><i class="fa-solid fa-bag-shopping"></i><h2>Your cart is empty</h2><p>Browse our Sweet and Savory Corners to fill it up.</p><a class="reference-button" href="/customer/products">Browse Products</a></section><% } else { const sweet = cart.filter((item) => item.product.category === 'sweet'); const savory = cart.filter((item) => item.product.category === 'savory'); %><div class="reference-grid"><section><% [[sweet, 'Sweet Corner', '🍬'], [savory, 'Savory Corner', '🌿']].forEach(([items, title, emoji]) => { if (items.length) { %><div class="cart-section"><div class="cart-section-title"><span><%= emoji %></span><strong><%= title %></strong><small>(<%= items.length %> item<%= items.length === 1 ? '' : 's' %>)</small></div><% items.forEach((item) => { %><article class="reference-item-card"><img src="/img/<%= item.product.image %>" alt="<%= item.product.name %>"><div class="reference-item-info"><h3><%= item.product.name %></h3><p><%= item.product.detail?.weight || '-' %> · <%= item.product.detail?.servings || '-' %></p><div class="reference-item-bottom"><form class="qty-control" method="POST" action="/customer/cart/<%= item.product._id %>/update"><button name="quantity" value="<%= Math.max(1, item.quantity - 1) %>" type="submit">−</button><span><%= item.quantity %></span><button name="quantity" value="<%= Math.min(5, item.quantity + 1) %>" type="submit" <%= item.quantity >= 5 ? 'disabled' : '' %>>+</button></form><div class="reference-item-price">Rp <%= (item.product.price * item.quantity).toLocaleString('id-ID') %><form method="POST" action="/customer/cart/<%= item.product._id %>/remove"><button class="remove-button" type="submit" title="Remove"><i class="fa-regular fa-trash-can"></i></button></form></div></div></div></article><% }) %></div><% } }) %><div class="promo-box"><i class="fa-solid fa-tag"></i><input placeholder="Enter promo code"><button type="button">Apply</button></div></section><aside class="reference-summary"><h2>Order Summary</h2><div class="summary-items"><% cart.forEach((item) => { %><div><span><%= item.product.name %> ×<%= item.quantity %></span><b>Rp <%= (item.product.price * item.quantity).toLocaleString('id-ID') %></b></div><% }) %></div><div class="summary-line"><span>Subtotal</span><b>Rp <%= subtotal.toLocaleString('id-ID') %></b></div><div class="summary-line"><span>Shipping</span><b>Rp <%= shipping.toLocaleString('id-ID') %></b></div><% if (subtotal < 200000) { %><p class="free-shipping-note">Add Rp <%= (200000 - subtotal).toLocaleString('id-ID') %> more for free shipping</p><% } %><div class="summary-total"><span>Total</span><b>Rp <%= total.toLocaleString('id-ID') %></b></div><a class="reference-button full" href="/customer/checkout">Proceed to Checkout <i class="fa-solid fa-arrow-right"></i></a><div class="payment-pills"><span>🏦 Bank Transfer</span><span>💳 E-Wallet</span></div><div class="preorder-note"><strong>Pre-order note:</strong> Items dibuat fresh dan payment harus dikirim dalam 24 jam.</div></aside></div><% } %></main></body></html>
