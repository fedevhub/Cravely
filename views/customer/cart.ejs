<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Shopping Cart</title><link rel="stylesheet" href="/css/theme.css"></head><body><%- include("../partials/navbar") %><main class="page-shell"><h1>Shopping Cart</h1><div class="cart-layout"><section><% if (cart?.items.length) { cart.items.forEach(item => { %><div class="panel cart-item"><img class="product-thumb" src="/img/<%= item.product.image %>" alt=""><div><h3><%= item.product.name %></h3><p>Rp <%= item.product.price.toLocaleString("id-ID") %></p><form method="post" action="/customer/cart/item/<%= item._id %>"><input type="number" name="quantity" min="1" value="<%= item.quantity %>"><button class="btn-link">Update</button></form></div><form method="post" action="/customer/cart/item/<%= item._id %>/delete"><button class="btn-link">Hapus</button></form></div><% }) } else { %><div class="panel">Cart masih kosong.</div><% } %></section><aside class="panel summary"><h2>Order Summary</h2><p>Subtotal <b>Rp <%= subtotal.toLocaleString("id-ID") %></b></p><p>Shipping <b>Rp <%= shipping.toLocaleString("id-ID") %></b></p><h2>Total Rp <%= total.toLocaleString("id-ID") %></h2><a class="btn-brown" href="/customer/checkout">Proceed to Checkout</a></aside></div></main></body></html>