<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order History</title><link rel="stylesheet" href="/css/theme.css"></head><body><%- include("../partials/navbar") %><main class="page-shell"><h1>Order History</h1><% orders.forEach(order => { %><div class="panel order-row"><div><strong><%= order.orderNumber %></strong><span><%= order.status %></span><small><%= new Date(order.createdAt).toLocaleDateString("id-ID") %></small></div><b>Rp <%= order.totalAmount.toLocaleString("id-ID") %></b><a class="btn-link" href="/customer/orders/<%= order._id %>/tracking">Track Order</a></div><% }) %><% if (!orders.length) { %><div class="panel">Belum ada pesanan.</div><% } %></main></body></html>