<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order Tracking</title><link rel="stylesheet" href="/css/theme.css"></head><body><%- include("../partials/navbar") %><main class="page-shell"><h1>Track Your Order</h1><div class="panel"><h2><%= order.orderNumber %></h2><p>Status saat ini: <strong><%= order.status %></strong></p><ol class="timeline"><% ["Waiting Payment","Payment Verification","Confirmed","In Production","Ready for Delivery","Delivered","Completed"].forEach(status => { %><li class="<%= status === order.status ? 'current' : '' %>"><%= status %></li><% }) %></ol><h3>Order Items</h3><% order.items.forEach(item => { %><p><%= item.product.name %> x <%= item.quantity %></p><% }) %></div></main></body></html>
