<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Track Order | Cravely</title>

  <!-- External Stylesheets -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Custom Stylesheets -->
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/customer-pages.css">
</head>
<body class="customer-page">

  <%- include('../partials/navbar') %>

  <main class="reference-page tracking-reference">
    <h1>Track Your Order</h1>
    <p class="reference-lead">Order details and current production status.</p>

    <!-- Search / Reference Bar -->
    <section class="tracking-search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <span><%= order.orderNumber %></span>
      <a href="/customer/history">Back to history</a>
    </section>

    <div class="tracking-grid">
      <!-- Main Tracking Details -->
      <article class="tracking-detail-card">
        <div class="tracking-dark-head">
          <div>
            <small>Order ID</small>
            <strong><%= order.orderNumber %></strong>
          </div>
          <div>
            <small>Placed</small>
            <strong><%= new Date(order.createdAt).toLocaleDateString('id-ID') %></strong>
          </div>
        </div>

        <div class="tracking-body">
          <h2>Order Timeline</h2>

          <!-- Timeline Steps -->
          <div class="tracking-timeline">
            <% 
              const statuses = ['Waiting Payment', 'Confirmed', 'In Production', 'Ready for Delivery', 'Delivered', 'Completed']; 
              const currentIndex = Math.max(0, statuses.indexOf(order.status)); 
              statuses.forEach((status, index) => { 
                const done = index <= currentIndex; 
                const active = status === order.status; 
            %>
              <div class="tracking-step <%= done ? 'done' : '' %> <%= active ? 'active' : '' %>">
                <span>
                  <i class="fa-solid <%= done ? (active ? 'fa-box' : 'fa-check') : 'fa-clock' %>"></i>
                </span>
                <div>
                  <strong><%= status %></strong>
                  <small><%= active ? 'Current status' : (done ? 'Completed' : 'Waiting') %></small>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Order Items -->
          <div class="tracking-items">
            <h3>Order Items</h3>
            <% order.items.forEach((item) => { %>
              <div class="tracking-item">
                <img src="/img/<%= item.product?.image || '' %>" alt="<%= item.product?.name || 'Product' %>">
                <span>
                  <strong><%= item.product?.name || 'Product' %></strong>
                  <small>Qty: <%= item.quantity %></small>
                </span>
                <b>Rp <%= (item.price * item.quantity).toLocaleString('id-ID') %></b>
              </div>
            <% }) %>
          </div>

          <!-- Quick Actions -->
          <div class="tracking-actions">
            <a href="/customer/payment/<%= order._id %>">
              <i class="fa-solid fa-receipt"></i> View Payment
            </a>
            <a href="mailto:hello@cravely.id">
              <i class="fa-regular fa-envelope"></i> Contact Support
            </a>
          </div>
        </div>
      </article>

      <!-- Order Summary Sidebar -->
      <aside class="reference-summary">
        <h2>Order Summary</h2>
        <div class="summary-line">
          <span>Status</span>
          <b><%= order.status %></b>
        </div>
        <div class="summary-line">
          <span>Payment</span>
          <b><%= order.paymentMethod %></b>
        </div>
        <div class="summary-line">
          <span>Shipping</span>
          <b>Rp 20.000</b>
        </div>
        <div class="summary-total">
          <span>Total</span>
          <b>Rp <%= order.totalAmount.toLocaleString('id-ID') %></b>
        </div>
        <div class="delivery-note">
          📦 <strong>Delivery:</strong> mengikuti jadwal batch pre-order aktif.
        </div>
      </aside>
    </div>
  </main>

</body>
</html>