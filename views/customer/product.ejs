<% const renderAsPartial = typeof isPartial !== "undefined" && isPartial; %>
<% const activeCategory = typeof selectedCategory !== "undefined" ? selectedCategory : "all"; %>
<% if (!renderAsPartial) { %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== "undefined" ? pageTitle : "Menu" %> | Cravely</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300..700;1,300..700&family=DM+Serif+Text:ital@0;1&family=Libertinus+Math&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/product-customer.css">
    <link rel="stylesheet" href="/css/modal.css">
</head>

<body>
    <%- include("../partials/navbar") %>
<% } %>
    <div class="container">
        <div class="main">
            <div class="main-content">
                <div class="product-management-wrapper">
                    <div class="content-header">
                        <div class="section-heading text-center mb-4">
                            <h2>Best Sellers</h2>
                            <p>Freshly baked favorites loved by our customers.</p>
                        </div>
                    </div>

                    <div class="filter-search-row">
                        <div class="filter-tabs">
                            <button class="filter-btn <%= activeCategory === "all" ? "active" : "" %>" data-filter="all">All Products</button>
                            <button class="filter-btn <%= activeCategory === "sweet" ? "active" : "" %>" data-filter="sweet">
                                Sweet Corner
                            </button>
                            <button class="filter-btn <%= activeCategory === "savory" ? "active" : "" %>" data-filter="savory">
                                Savory Corner
                            </button>
                        </div>

                        <div class="search-box">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" id="searchInput" placeholder="Search products..."
                                class="search-input">
                        </div>
                    </div>
                </div>

                    <div class="row g-4">
                        <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <div class="col-xl-3 col-lg-3 col-md-6 mb-4 product-item"
                                data-category="<%= product.category.toLowerCase() %>">
                                <div class="product-card" role="link" tabindex="0"
                                    data-detail-url="/customer/detailProducts/<%= product._id %>">
                                    <div class="card-image">
                                        <img src="/img/<%= product.image %>" alt="<%= product.name %>"
                                            class="card-img-top">

                                        <div class="badge-left">
                                            <% if(product.isActive === "ready stok") { %>
                                                <span class="badge-status badge-ready">Ready Stock</span>
                                            <% } else { %>
                                                <span class="badge-status badge-preorder">Pre Order</span>
                                            <% } %>
                                        </div>

                                        <div class="badge-right">
                                            <span class="badge-category">
                                                <%= product.category %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <h3 class="card-title">
                                            <%= product.name %>
                                        </h3>
                                        <p class="card-description">
                                            <%= product.description %>
                                        </p>

                                        <div class="card-footer-custom">
                                            <div class="price">
                                                <span class="currency">Rp</span>
                                                <%= Number(product.price).toLocaleString("id-ID") %>
                                            </div>

                                            <form method="POST" action="/customer/cart/<%= product._id %>">
                                            <button type="submit"
                                                class="cart-button <%= !isPreOrderOpen ? 'order-disabled' : '' %>"
                                                <%= isPreOrderOpen ? '' : 'disabled' %>
                                                title="<%= isPreOrderOpen ? 'Add to cart' : 'Pre-order sedang ditutup' %>">
                                                <i class="fa-solid fa-cart-shopping"></i>
                                                <span><%= isPreOrderOpen ? 'Add to cart' : 'Order Closed' %></span>
                                            </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                        <% } else { %>
                            <div class="col-12">
                                <div class="empty-menu text-center py-5">
                                    <h3>Belum ada menu</h3>
                                    <p>Menu yang ditambahkan admin akan muncul otomatis di sini.</p>
                                </div>
                            </div>
                        <% } %>
                </div>
            </div>
        </div>
    </div>

<% if (!renderAsPartial) { %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('../partials/status-modal') %>
<% } %>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const searchInput = document.getElementById('searchInput');
            const productItems = document.querySelectorAll('.product-item');

            let currentFilter = '<%= activeCategory %>';
            let searchQuery = '';

            function filterProducts() {
                productItems.forEach(item => {
                    const titleElement = item.querySelector('.card-title');
                    const productName = titleElement ? titleElement.textContent.toLowerCase() : '';

                    const productCategory = item.getAttribute('data-category');
                    const matchesCategory = (currentFilter === 'all') || (productCategory === currentFilter);
                    const matchesSearch = productName.includes(searchQuery);
                    if (matchesCategory && matchesSearch) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            filterButtons.forEach(button => {
                button.addEventListener('click', function () {
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    currentFilter = this.getAttribute('data-filter');
                    filterProducts();
                });
            });

            searchInput.addEventListener('input', function () {
                searchQuery = this.value.toLowerCase().trim();
                filterProducts();
            });

            productItems.forEach(item => {
                const card = item.querySelector('.product-card');

                if (!card) {
                    return;
                }

                card.addEventListener('click', function (event) {
                    if (event.target.closest('button, a')) {
                        return;
                    }

                    window.location.href = this.dataset.detailUrl;
                });

                card.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        window.location.href = this.dataset.detailUrl;
                    }
                });
            });

            filterProducts();
        });
    </script>
<% if (!renderAsPartial) { %>
</body>

</html>
<% } %>
