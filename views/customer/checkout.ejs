<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout</title><link rel="stylesheet" href="/css/theme.css"></head><body><%- include("../partials/navbar") %><main class="page-shell"><h1>Checkout</h1><form class="panel profile-form" method="post" action="/customer/checkout"><label>Alamat pengiriman<textarea name="shippingAddress" required><%= user.address %></textarea></label><label>Metode pembayaran<select name="paymentMethod"><option>Transfer</option><option>QRIS</option><option>COD</option></select></label><label>Catatan<textarea name="customerNote"></textarea></label><h2>Total Rp <%= total.toLocaleString("id-ID") %></h2><button class="btn-brown">Place Order</button></form></main></body></html>