<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout | Cravely</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="/css/home.css"><link rel="stylesheet" href="/css/customer-pages.css"></head>
<body class="customer-page"><%- include('../partials/navbar') %><main class="reference-page checkout-reference"><a class="reference-back" href="/customer/cart"><i class="fa-solid fa-chevron-left"></i> Back to Cart</a><h1>Checkout</h1><div class="checkout-steps"><span class="active"><b>1</b> Shipping</span><i></i><span class="active"><b>2</b> Payment</span><i></i><span><b>3</b> Review</span></div><div class="reference-grid"><form class="reference-form-card" method="POST" action="/customer/checkout"><h2><i class="fa-solid fa-location-dot"></i> Shipping Information</h2><div class="form-grid-reference"><label class="full">Full Name<input name="fullname" value="<%= user.fullname %>" required></label><label>Email<input type="email" name="email" value="<%= user.email %>"></label><label>Phone Number<input name="phoneNumber" value="<%= user.phoneNumber %>" required></label><label class="full">Street Address<textarea name="shippingAddress" required><%= user.address %></textarea></label><label>City<input name="city" placeholder="Jakarta Selatan"></label><label>Province<select name="province"><option value="">Select province</option><option>Jawa Timur</option><option>Jawa Barat</option><option>DKI Jakarta</option></select></label><label>Postal Code<input name="postal" placeholder="12345"></label><label class="full">Delivery Notes <small>(optional)</small><textarea name="customerNote" placeholder="e.g. Leave at door, call before delivery..."></textarea></label><label class="full">Payment Method<select name="paymentMethod"><option value="Transfer">🏦 BCA Bank Transfer</option><option value="QRIS">💳 QRIS / E-Wallet</option><option value="COD">💵 COD</option></select></label></div><button class="reference-button" type="submit">Place Order <i class="fa-solid fa-arrow-right"></i></button></form><aside class="reference-summary checkout-summary"><h2>Order Summary (<%= cart.length %> items)</h2><% cart.forEach((item) => { %><div class="summary-product"><img src="/img/<%= item.product.image %>" alt="<%= item.product.name %>"><span><%= item.product.name %> ×<%= item.quantity %></span><b>Rp <%= (item.product.price * item.quantity).toLocaleString('id-ID') %></b></div><% }) %><div class="summary-line"><span>Subtotal</span><b>Rp <%= subtotal.toLocaleString('id-ID') %></b></div><div class="summary-line"><span>Shipping</span><b>Rp <%= shipping.toLocaleString('id-ID') %></b></div><div class="summary-total"><span>Total</span><b>Rp <%= total.toLocaleString('id-ID') %></b></div><div class="delivery-note">📦 <strong>Estimated delivery:</strong> berdasarkan batch pre-order aktif.</div></aside></div></main></body></html>
