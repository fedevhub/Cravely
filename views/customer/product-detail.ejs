<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | Cravely</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/product-customer.css">
</head>

<body>
    <%- include("../partials/navbar") %>

    <main class="container py-5">
        <a href="/customer/products" class="btn btn-sm btn-outline-secondary mb-4">
            <i class="bi bi-arrow-left"></i> Back to Menu
        </a>

        <div class="row g-4 align-items-start">
            <div class="col-lg-6">
                <div class="product-card">
                    <div class="card-image" style="height: 420px;">
                        <img src="/img/<%= product.image %>" alt="<%= product.name %>" class="card-img-top">
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <span class="badge-category mb-3"><%= product.category %></span>
                <h1 class="page-title"><%= product.name %></h1>
                <p class="card-description fs-6"><%= product.detail && product.detail.fullDescription ? product.detail.fullDescription : product.description %></p>

                <div class="price mb-4">
                    <span class="currency">Rp</span>
                    <%= Number(product.price).toLocaleString("id-ID") %>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <% if(product.isActive === "ready stok") { %>
                        <span class="badge-status badge-ready">Ready Stock</span>
                    <% } else { %>
                        <span class="badge-status badge-preorder">Pre Order</span>
                    <% } %>
                </div>

                <form method="post" action="/customer/cart/add/<%= product._id %>" class="d-inline"><button type="submit" class="cart-button mb-4">
                    <i class="bi bi-cart3"></i>
                    <span>Add to cart</span>
                </button></form>
                <form method="post" action="/customer/wishlist/toggle/<%= product._id %>" class="d-inline"><button type="submit" class="btn btn-outline-secondary mb-4"><i class="bi bi-heart"></i> <%= isFavorite ? "Hapus favorit" : "Sukai menu" %></button></form>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <strong>Weight</strong>
                        <p><%= product.detail && product.detail.weight ? product.detail.weight : "-" %></p>
                    </div>
                    <div class="col-sm-6">
                        <strong>Servings</strong>
                        <p><%= product.detail && product.detail.servings ? product.detail.servings : "-" %></p>
                    </div>
                </div>

                <% if (product.detail && product.detail.ingredients && product.detail.ingredients.length > 0) { %>
                    <h5>Ingredients</h5>
                    <ul>
                        <% product.detail.ingredients.forEach(function(item) { %>
                            <li><%= item %></li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
