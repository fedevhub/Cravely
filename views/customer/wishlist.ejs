<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Menu Favorit</title><link rel="stylesheet" href="/css/theme.css"></head><body><%- include("../partials/navbar") %><main class="page-shell"><h1>Menu Favorit</h1><div class="product-grid"><% products.forEach(product => { %><article class="panel"><img class="product-img" src="/img/<%= product.image %>" alt="<%= product.name %>"><h3><%= product.name %></h3><p>Rp <%= product.price.toLocaleString("id-ID") %></p><form method="post" action="/customer/cart/add/<%= product._id %>"><button class="btn-brown">Tambah ke Cart</button></form><form method="post" action="/customer/wishlist/toggle/<%= product._id %>"><button class="btn-link">Hapus favorit</button></form></article><% }) %></div><% if (!products.length) { %><p>Belum ada menu favorit.</p><% } %></main></body></html>
