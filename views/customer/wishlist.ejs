<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Wishlist</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/product-customer.css" />
    <link rel="stylesheet" href="/css/customer-pages.css" />
    <link rel="stylesheet" href="/css/enhancements.css" />
  </head>
  <body class="customer-page">
    <%- include('../partials/navbar') %>
    <main class="reference-page wishlist-reference">
      <h1>
        My Wishlist
        <small>(<%= products.length %> item<%= products.length === 1 ? '' : 's' %>)</small>
      </h1>
      <div class="row g-4 mt-3">
        <% if (products.length) { %>
          <% products.forEach((product) => { %>
            <div class="col-md-4">
              <article class="customer-card">
                <img
                  class="w-100 rounded mb-3"
                  src="/img/<%= product.image %>"
                  alt="<%= product.name %>"
                />
                <h2><%= product.name %></h2>
                <p>
                  <% if (product.discount > 0) { %>
                    <span class="price-old">Rp <%= product.price.toLocaleString('id-ID') %></span>
                    Rp <%= (product.price * (1 - product.discount / 100)).toLocaleString('id-ID') %>
                    <span class="badge-discount">-<%= product.discount %>%</span>
                  <% } else { %>
                    Rp <%= product.price.toLocaleString('id-ID') %>
                  <% } %>
                </p>
                <div class="d-flex gap-2">
                  <a class="customer-button" href="/customer/detailProducts/<%= product._id %>">Lihat</a>
                  <form method="POST" action="/customer/wishlist/<%= product._id %>">
                    <button class="customer-button outline" type="submit">Remove</button>
                  </form>
                </div>
              </article>
            </div>
          <% }) %>
        <% } else { %>
          <p>Belum ada menu yang disukai.</p>
        <% } %>
      </div>
    </main>
  </body>
</html>
