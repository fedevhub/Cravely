<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Struk <%= order.orderNumber %> | Cravely</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer-pages.css">
    <link rel="stylesheet" href="/css/enhancements.css">
</head>
<body class="customer-page">
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <div class="product-container">
            <%- include('../partials/sidebar') %>
            <div class="main"><div class="main-content" style="padding-top:24px;">
    <% } else { %>
        <%- include('../partials/navbar') %>
        <main class="reference-page receipt-reference" style="padding-top:24px;">
    <% } %>

    <section class="receipt-paper" id="receiptPaper">
        <h2>Cravely</h2>
        <p class="receipt-brand">Freshly Baked Goods &middot; Struk Pesanan</p>

        <div class="receipt-row"><span>No. Order</span><strong><%= order.orderNumber %></strong></div>
        <div class="receipt-row"><span>Tanggal</span><span><%= new Date(order.createdAt).toLocaleString('id-ID') %></span></div>
        <div class="receipt-row"><span>Pelanggan</span><span><%= order.user ? order.user.fullname : '-' %></span></div>
        <div class="receipt-row"><span>Status</span><span><%= order.status %></span></div>

        <hr class="receipt-divider">

        <% (order.items || []).forEach(function (item) { %>
            <div class="receipt-row">
                <span><%= item.product ? item.product.name : 'Produk' %> &times;<%= item.quantity %></span>
                <span>Rp <%= ((item.price || 0) * item.quantity).toLocaleString('id-ID') %></span>
            </div>
        <% }) %>

        <hr class="receipt-divider">

        <div class="receipt-row"><span>Alamat</span></div>
        <div class="receipt-row"><small><%= order.shippingAddress || '-' %></small></div>
        <div class="receipt-row"><span>Metode Bayar</span><span><%= order.paymentMethod %></span></div>
        <div class="receipt-row total"><span>Total</span><span>Rp <%= (order.totalAmount || 0).toLocaleString('id-ID') %></span></div>

        <hr class="receipt-divider">
        <p class="receipt-brand" style="margin-bottom:0;">Terima kasih sudah memesan di Cravely! &#127856;</p>
    </section>

    <div class="receipt-actions no-print">
        <button type="button" onclick="window.print()"><i class="fa-solid fa-print"></i> Print Struk</button>
        <button type="button" onclick="window.print()"><i class="fa-solid fa-file-pdf"></i> Save PDF</button>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <a href="/dashboard/orders" style="background:linear-gradient(180deg,#c9803b,#8a4316);"><i class="fa-solid fa-arrow-left"></i> Kembali</a>
        <% } %>
    </div>

    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            </div></div>
        </div>
    <% } else { %>
        </main>
    <% } %>
</body>
</html>
