<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications | Cravely</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer-pages.css">
    <link rel="stylesheet" href="/css/admin-pages.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/modal.css">
</head>
<body class="notifications-page <%= isAdmin ? 'admin-notifications-page' : 'customer-page' %>">
    <% if (isAdmin) { %>
        <div class="dashboard-container">
            <%- include('../partials/sidebar') %>
            <main class="admin-page notifications-content">
    <% } else { %>
        <%- include('../partials/navbar') %>
        <main class="customer-shell notifications-content">
    <% } %>
                <header class="notifications-header">
                    <div>
                        <p class="profile-eyebrow">ACTIVITY CENTER</p>
                        <h1>Notifications</h1>
                        <p class="profile-subtitle">Pesanan dan aktivitas terbaru akan muncul di sini.</p>
                    </div>
                    <form method="POST" action="/notifications/read-all">
                        <button class="customer-button outline" type="submit"><i class="fa-solid fa-check-double"></i> Mark all read</button>
                    </form>
                </header>
                <section class="notification-card">
                    <% if (notifications.length) { notifications.forEach((notification) => { %>
                        <a class="notification-item <%= notification.readAt ? '' : 'unread' %>" href="<%= notification.link %>">
                            <span class="notification-icon <%= notification.type %>"><i class="fa-solid <%= notification.type === 'order' ? 'fa-bag-shopping' : notification.type === 'payment' ? 'fa-credit-card' : 'fa-bell' %>"></i></span>
                            <span class="notification-copy"><strong><%= notification.title %></strong><span><%= notification.message %></span><small><%= new Date(notification.createdAt).toLocaleString('id-ID') %></small></span>
                            <i class="fa-solid fa-chevron-right notification-arrow"></i>
                        </a>
                    <% }) } else { %>
                        <div class="notification-empty"><i class="fa-regular fa-bell-slash"></i><strong>No notifications yet</strong><span>Aktivitas baru akan tampil di sini.</span></div>
                    <% } %>
                </section>
    <% if (isAdmin) { %>
            </main>
        </div>
    <% } else { %>
        </main>
    <% } %>
</body>
</html>
